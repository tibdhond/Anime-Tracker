{
  "expo": {
    "name": "Anime-Tracker",
    "slug": "Anime-Tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tanjonion.png",
    "scheme": "animetracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/tanjonion.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/tanjonion.png",
        "backgroundImage": "./assets/images/tanjonion.png",
        "monochromeImage": "./assets/images/tanjonion.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.animetracker"
    },
      "web": {
      "output": "static",
      "favicon": "./assets/images/tanjonion.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/tanjonion.png",
          "imageWidth": 76
        }
      ],
      "expo-web-browser",
      "expo-image",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
